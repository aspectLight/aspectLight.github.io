---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';

import { HOME_PATHS } from '@core/constants/routes.constants';
import { Locale } from '@core/enums/locale.enum';
import { getTranslations } from '@i18n/i18n';
import '../styles/global.css';

interface Props {
  readonly locale: Locale;
  readonly title: string;
  readonly description: string;
  /** Only real pages have alternates; the 404 page has none. */
  readonly hasAlternates: boolean;
}

const { locale, title, description, hasAlternates } = Astro.props;
const t = getTranslations(locale);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const alternates = Object.values(Locale).map((alternate) => ({
  locale: alternate,
  href: new URL(HOME_PATHS[alternate], Astro.site).href,
}));
---

<!doctype html>
<!-- No page-wide animation: switching language swaps the text in place. -->
<html lang={locale} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.jpg" type="image/jpeg" />
    {hasAlternates && (
      <>
        <link rel="canonical" href={canonicalUrl.href} />
        {alternates.map((alternate) => (
          <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />
        ))}
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(HOME_PATHS[Locale.En], Astro.site).href}
        />
      </>
    )}
    <ClientRouter />
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-mono" preload />
  </head>
  <body>
    <a class="skip-link" href="#content">
      {t.skipToContent}
    </a>
    <slot />
  </body>
</html>
