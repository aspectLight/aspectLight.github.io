---
import { Font, getImage } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';

import { HOME_PATHS } from '@core/constants/routes.constants';
import { Locale } from '@core/enums/locale.enum';
import { getTranslations } from '@i18n/i18n';
import shareImageSource from '../assets/avatar-terracotta.png';
import '../styles/global.css';

interface Props {
  readonly locale: Locale;
  readonly title: string;
  readonly description: string;
  /** Only real pages have alternates; the 404 page has none. */
  readonly hasAlternates: boolean;
}

const { locale, title, description, hasAlternates } = Astro.props;
const t = getTranslations(locale);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
/** Link previews in LinkedIn, Slack or e-mail: a square JPEG, which every crawler accepts. */
const SHARE_IMAGE_SIZE = 600;
const OPEN_GRAPH_LOCALES: Readonly<Record<Locale, string>> = {
  [Locale.En]: 'en_CA',
  [Locale.Fr]: 'fr_CA',
};
const shareImage = await getImage({
  src: shareImageSource,
  width: SHARE_IMAGE_SIZE,
  height: SHARE_IMAGE_SIZE,
  format: 'jpg',
});
const shareImageUrl = new URL(shareImage.src, Astro.site).href;
const alternates = Object.values(Locale).map((alternate) => ({
  locale: alternate,
  href: new URL(HOME_PATHS[alternate], Astro.site).href,
}));
---

<!doctype html>
<!-- No page-wide animation: switching language swaps the text in place. -->
<html lang={locale} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.jpg" type="image/jpeg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:locale" content={OPEN_GRAPH_LOCALES[locale]} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:alt" content={t.avatarAlt} />
    <meta name="twitter:card" content="summary" />
    {hasAlternates && (
      <>
        <link rel="canonical" href={canonicalUrl.href} />
        {alternates.map((alternate) => (
          <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />
        ))}
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(HOME_PATHS[Locale.En], Astro.site).href}
        />
      </>
    )}
    <ClientRouter />
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-mono" preload />
  </head>
  <body>
    <a class="skip-link" href="#content">
      {t.skipToContent}
    </a>
    <slot />
  </body>
</html>
