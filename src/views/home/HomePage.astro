---
import { readGitRevisionDate } from '@adapters/git-revision';
import { ABSTRACT } from '@content/abstract';
import { EDUCATION } from '@content/education';
import { PROFILE } from '@content/profile';
import { formatMonth, formatRevision } from '@i18n/format';
import type { Locale } from '@i18n/locales';
import { otherLocale } from '@i18n/locales';
import { homePath } from '@i18n/routes';
import { UI } from '@i18n/ui';
import ContactBlock from '../../components/ContactBlock.astro';
import EducationEntry from '../../components/EducationEntry.astro';
import HomeSection from '../../components/HomeSection.astro';
import ReliabilityDiagram from '../../components/reliability-diagram/ReliabilityDiagram.astro';
import RunningHead from '../../components/running-head/RunningHead.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TitleBlock from '../../components/TitleBlock.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildHomeSections } from './build-home-sections';

interface Props {
  readonly locale: Locale;
}

const { locale } = Astro.props;
const copy = UI[locale];
const other = otherLocale(locale);
const sections = buildHomeSections(locale);
const revisionDate = readGitRevisionDate();
const revisionLabel = revisionDate === undefined ? undefined : formatRevision(revisionDate, locale);
const education = EDUCATION[0];
const contents = sections.map((section) => ({
  href: `#${section.id}`,
  label: `${section.number} ${section.title}`,
}));
---

<BaseLayout
  locale={locale}
  title={copy.pageTitle}
  description={copy.pageDescription}
  skipLabel={copy.skipToContent}
  alternates={[
    { locale: 'en', href: homePath('en') },
    { locale: 'fr', href: homePath('fr') },
  ]}
>
  <RunningHead
    locale={locale}
    name={PROFILE.displayName}
    homeHref={homePath(locale)}
    sectionLabel={revisionLabel ?? copy.revisionLabel}
    languageNavLabel={copy.languageNavLabel}
    currentLocaleLabel={copy.localeName[locale]}
    otherLocale={other}
    otherLocaleLabel={copy.localeName[other]}
    otherHref={homePath(other)}
  />
  <main id="content">
    <TitleBlock
      givenName={PROFILE.givenName}
      familyName={PROFILE.familyName}
      authorLine={copy.authorLine}
      abstractLabel={copy.abstractLabel}
      abstract={ABSTRACT.text[locale]}
      contentsLabel={copy.contentsLabel}
      contentsNavLabel={copy.contentsNavLabel}
      avatarAlt={copy.avatarAlt}
      avatarCaption={copy.avatarCaption}
      contents={contents}
    >
      <ReliabilityDiagram
        caption={copy.reliabilityCaption}
        confidenceAxis={copy.confidenceAxis}
        accuracyAxis={copy.accuracyAxis}
      />
    </TitleBlock>
    {
      sections.map((section) => (
        <HomeSection
          id={section.id}
          label={`${section.number} — ${section.title}`}
          state={section.state}
          emptyMessage={section.emptyMessage}
        >
          {section.id === 'education' ? (
            <EducationEntry
              institution={education.institution}
              degree={education.degree[locale]}
              track={education.track[locale]}
              dates={`${formatMonth(education.start, locale)} – ${formatMonth(education.end, locale)} ${copy.expectedLabel}`}
              place={education.place}
              courseworkLabel={copy.courseworkLabel}
              coursework={education.coursework[locale].join(' · ')}
            />
          ) : null}
          {section.id === 'contact' ? (
            <ContactBlock
              lead={copy.contactLead}
              email={PROFILE.email}
              linkedInLabel={copy.linkedInLabel}
              linkedInUrl={PROFILE.linkedInUrl}
              gitHubLabel={copy.gitHubLabel}
              gitHubUrl={PROFILE.gitHubUrl}
            />
          ) : null}
        </HomeSection>
      ))
    }
  </main>
  <SiteFooter
    revisionLabel={revisionLabel}
    localeLabel={copy.localeName[locale]}
    otherLocaleLabel={copy.localeName[other]}
    otherHref={homePath(other)}
    otherLocale={other}
  />
</BaseLayout>
