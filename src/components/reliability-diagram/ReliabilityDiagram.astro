---
import {
  reliabilityBarsFromSample,
  reliabilityDiagonal,
  reliabilityStepFromSample,
} from './reliability-geometry';

interface Props {
  readonly caption: string;
  readonly confidenceAxis: string;
  readonly accuracyAxis: string;
}

const { caption, confidenceAxis, accuracyAxis } = Astro.props;
const bars = reliabilityBarsFromSample();
const diagonal = reliabilityDiagonal();
const steps = reliabilityStepFromSample();
---

<figure class="reliability-diagram">
  <svg viewBox="0 0 240 240" aria-hidden="true">
    <defs>
      <pattern id="reliability-hatch" width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="4" />
      </pattern>
    </defs>
    {
      bars.map((bar) => (
        <rect x={bar.x} y={bar.y} width={bar.width} height={bar.height} fill="url(#reliability-hatch)" />
      ))
    }
    <polyline points={diagonal} />
    <polyline points={steps} />
    <text x="118" y="232">{confidenceAxis}</text>
    <text x="8" y="120" transform="rotate(-90 8 120)">{accuracyAxis}</text>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .reliability-diagram {
    margin: var(--space-6) 0 0;
    max-inline-size: 14rem;
  }

  .reliability-diagram svg {
    inline-size: 100%;
  }

  .reliability-diagram line {
    stroke: var(--color-hatch);
    stroke-width: 1;
  }

  .reliability-diagram polyline {
    fill: none;
    stroke: var(--color-fig);
    stroke-width: 1;
  }

  .reliability-diagram text {
    fill: var(--color-muted);
    font-family: var(--font-code);
    font-size: 8px;
  }

  .reliability-diagram figcaption {
    color: var(--color-muted);
    font-size: var(--type-mono-small-size);
    line-height: var(--type-mono-small-leading);
    margin-block-start: var(--space-2);
  }

  @media (min-width: 1100px) {
    .reliability-diagram {
      justify-self: end;
      margin-block-start: 0;
      opacity: 0.9;
    }
  }
</style>
