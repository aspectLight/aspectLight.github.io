---
interface Props {
  readonly revisionLabel: string | undefined;
  readonly localeLabel: string;
  readonly otherLocaleLabel: string;
  readonly otherHref: string;
  readonly otherLocale: string;
}

const { revisionLabel, localeLabel, otherLocaleLabel, otherHref, otherLocale } = Astro.props;
---

<footer class="site-footer">
  <p>
    {revisionLabel === undefined ? null : revisionLabel}
    {revisionLabel === undefined ? null : ' · '}
    <span aria-current="true">{localeLabel}</span>
    {' · '}
    <a href={otherHref} hreflang={otherLocale} lang={otherLocale}>{otherLocaleLabel}</a>
  </p>
</footer>

<style>
  .site-footer {
    border-block-start: 0.0625rem solid var(--color-rule);
    color: var(--color-muted);
    font-size: var(--type-mono-small-size);
    line-height: var(--type-mono-small-leading);
    margin-inline: var(--space-gutter);
    padding-block: var(--space-5);
  }

  @media (min-width: 1100px) {
    .site-footer {
      margin-inline: var(--space-offset);
    }
  }
</style>
