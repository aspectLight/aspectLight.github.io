---
import type { Locale } from '@core/enums/locale.enum';
import { revealDelay } from '@core/motion/reveal-delay';
import { getTranslations } from '@i18n/i18n';

interface Props {
  readonly locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<figure class="epigraph">
  <blockquote class="epigraph__quote" data-reveal>
    <p>{t.epigraphQuote}</p>
  </blockquote>
  <figcaption class="epigraph__author" data-reveal style={revealDelay(1)}>
    — {t.epigraphAuthor}
  </figcaption>
</figure>

<style>
  .epigraph {
    padding-block: var(--space-section);
    padding-inline: var(--layout-offset) var(--space-gutter);
  }

  .epigraph__quote {
    font-family: var(--font-family-serif);
    font-size: var(--type-entry-size);
    font-style: italic;
    line-height: var(--type-entry-leading);
    margin: 0 0 var(--space-3);
    max-inline-size: var(--layout-column);
  }

  .epigraph__author {
    color: var(--color-muted);
    font-size: var(--type-small-size);
  }
</style>
