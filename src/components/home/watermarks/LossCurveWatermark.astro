---
import Watermark from '@components/ui/Watermark.astro';
---

<!-- A training loss falling over epochs. -->
<Watermark>
  <svg width="220" height="130" viewBox="0 0 220 130" fill="none" stroke="currentColor">
    <line x1="24" y1="104" x2="204" y2="104" stroke-width="0.8" />
    <line x1="24" y1="10" x2="24" y2="104" stroke-width="0.8" />
    <path d="M 26 16 C 44 58, 60 76, 84 86 C 110 96, 140 98, 202 99" stroke-width="1.2" />
    <path
      d="M 26 22 C 46 60, 64 76, 90 82 C 118 88, 150 86, 202 80"
      stroke-width="0.8"
      stroke-dasharray="3 3"
    />
    <text x="30" y="14" font-size="9" fill="currentColor" stroke="none" font-family="serif">
      ℒ(θ)
    </text>
    <text x="170" y="120" font-size="8" fill="currentColor" stroke="none" font-family="monospace">
      epoch
    </text>
  </svg>
</Watermark>
