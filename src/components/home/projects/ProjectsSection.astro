---
import EmptyState from '@components/ui/EmptyState.astro';
import EntryReference from '@components/ui/EntryReference.astro';
import AttentionWatermark from '@components/home/watermarks/AttentionWatermark.astro';
import Section from '@components/ui/Section.astro';
import { SectionId } from '@core/enums/section-id.enum';
import { revealDelay } from '@core/motion/reveal-delay';
import { PROJECTS } from '@data/projects.data';
import { getTranslations } from '@i18n/i18n';
import type { SectionProps } from '../section-props.types';

type Props = SectionProps;

const { locale, number } = Astro.props;
const t = getTranslations(locale);
const isEmpty = PROJECTS.length === 0;
---

<Section id={SectionId.Projects} number={number} title={t.sectionTitles[SectionId.Projects]}>
  <AttentionWatermark />
  {isEmpty && <EmptyState message={t.emptyProjects} />}
  {!isEmpty && (
    <ol class="project-list">
      {PROJECTS.map((project, index) => (
        <li class="project-entry" id={project.id} data-reveal style={revealDelay(index + 1)}>
          <EntryReference number={index + 1} />
          <div>
            <h3 class="project-entry__title">{project.title[locale]}</h3>
            <p class="project-entry__meta">
              {project.period[locale]} · {project.context[locale]}
            </p>
            <p class="project-entry__summary">{project.summary[locale]}</p>
            {(project.sourceUrl !== undefined || project.demoUrl !== undefined) && (
              <p class="project-entry__links">
                {project.sourceUrl !== undefined && (
                  <a href={project.sourceUrl}>{t.sourceLabel} ↗</a>
                )}
                {project.demoUrl !== undefined && <a href={project.demoUrl}>{t.demoLabel} ↗</a>}
              </p>
            )}
          </div>
        </li>
      ))}
    </ol>
  )}
</Section>

<style>
  .project-list {
    display: grid;
    gap: var(--space-7);
    max-inline-size: var(--layout-column);
  }

  .project-entry {
    /* Keeps a linked entry's title clear of the fixed section marker. */
    scroll-margin-block-start: var(--layout-marker-clearance);
    display: grid;
    gap: var(--space-3);
    grid-template-columns: auto 1fr;
  }

  .project-entry__title {
    font-family: var(--font-family-serif);
    font-size: var(--type-entry-size);
    font-weight: 400;
    line-height: var(--type-entry-leading);
  }

  .project-entry__meta {
    color: var(--color-muted);
    font-size: var(--type-small-size);
    margin-block: var(--space-1) var(--space-3);
  }

  .project-entry__summary {
    max-inline-size: var(--layout-column);
  }

  .project-entry__links {
    display: flex;
    gap: var(--space-4);
  }
</style>
