---
import type { Locale } from '@core/enums/locale.enum';
import { revealDelay } from '@core/motion/reveal-delay';
import { FEATURES } from '@data/features.data';
import { getTranslations } from '@i18n/i18n';

interface Props {
  readonly locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<ul class="feature-list" aria-label={t.featureListLabel}>
  {FEATURES.map((feature, index) => (
    <li class="feature" data-reveal style={revealDelay(index)}>
      <span class="feature__label">
        {t.featureLabel} x<sub>{index + 1}</sub>.
      </span>
      <span class="feature__value">
        <span aria-hidden="true" data-count-to={feature.value}>
          {feature.value}
        </span>
        <span class="visually-hidden">{feature.value}</span>
      </span>
      <span class="feature__description">{feature.description[locale]}</span>
    </li>
  ))}
</ul>

<script>
  import { initFeatureCount } from './feature-count.client';

  initFeatureCount(document);
</script>

<style>
  .feature-list {
    display: grid;
    gap: var(--space-1);
    max-inline-size: var(--layout-column);
    padding-block: 0 var(--space-section);
    padding-inline: var(--layout-offset) var(--space-gutter);
    box-sizing: content-box;
  }

  .feature {
    align-items: baseline;
    display: grid;
    column-gap: var(--space-4);
    grid-template-columns: var(--layout-feature-label) var(--layout-feature-value) 1fr;
    padding-block: var(--space-2);
  }

  .feature__label {
    color: var(--color-accent);
    font-size: var(--type-small-size);
    white-space: nowrap;
  }

  .feature__value {
    font-family: var(--font-family-serif);
    font-size: var(--type-feature-size);
    font-variant-numeric: tabular-nums;
    line-height: var(--type-feature-leading);
  }

  .feature__description {
    color: var(--color-muted);
    font-size: var(--type-small-size);
  }

  @media (width < 700px) {
    .feature {
      grid-template-columns: auto 1fr;
    }

    .feature__description {
      grid-column: 1 / -1;
    }
  }
</style>
