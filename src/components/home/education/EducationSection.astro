---
import EntryReference from '@components/ui/EntryReference.astro';
import LossCurveWatermark from '@components/home/watermarks/LossCurveWatermark.astro';
import Section from '@components/ui/Section.astro';
import { SectionId } from '@core/enums/section-id.enum';
import { revealDelay } from '@core/motion/reveal-delay';
import { EDUCATION } from '@data/education.data';
import { getTranslations } from '@i18n/i18n';
import type { SectionProps } from '../section-props.types';
import { formatEducationPeriod } from './education.format';

type Props = SectionProps;

const { locale, number } = Astro.props;
const t = getTranslations(locale);
---

<Section id={SectionId.Education} number={number} title={t.sectionTitles[SectionId.Education]}>
  <LossCurveWatermark />
  <ol class="education-list">
    {EDUCATION.map((entry, index) => (
      <li class="education-entry" data-reveal style={revealDelay(index + 1)}>
        <EntryReference number={index + 1} />
        <div>
          <h3 class="education-entry__institution">{entry.institution}</h3>
          <p class="education-entry__degree">{entry.degree[locale]}</p>
          <p class="education-entry__degree">{entry.track[locale]}</p>
          <p class="education-entry__period">{formatEducationPeriod(entry, locale)}</p>
          <p class="education-entry__coursework">
            <span class="education-entry__muted">{t.setIntro}</span>{' '}
            <em class="education-entry__set">D</em>
            <sub>train</sub> = {'{'} {entry.coursework[locale].join(', ')} {'}'}
          </p>
        </div>
      </li>
    ))}
  </ol>
</Section>

<style>
  .education-list {
    display: grid;
    gap: var(--space-7);
    max-inline-size: var(--layout-column);
  }

  .education-entry {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: auto 1fr;
  }

  .education-entry__institution {
    font-family: var(--font-family-serif);
    font-size: var(--type-entry-size);
    font-weight: 400;
    line-height: var(--type-entry-leading);
    margin-block-end: var(--space-2);
  }

  .education-entry__period {
    color: var(--color-muted);
    font-size: var(--type-small-size);
    margin-block: var(--space-2) var(--space-4);
  }

  .education-entry__muted {
    color: var(--color-muted);
  }

  .education-entry__set {
    color: var(--color-accent);
    font-family: var(--font-family-serif);
    font-size: var(--type-label-size);
  }
</style>
