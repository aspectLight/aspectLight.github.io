---
import Section from '@components/ui/section/Section.astro';
import { SectionId } from '@core/enums/section-id.enum';
import { revealDelay } from '@core/motion/reveal-delay';
import { PROFILE } from '@data/profile.data';
import { getTranslations } from '@i18n/i18n';
import type { SectionProps } from '../section-registry/section-props.types';
import { CONTACT_ICON_PATHS, ICON_VIEWBOX_SIZE } from './contact-icons.constants';
import { ContactMethod } from './contact-method.enum';

type Props = SectionProps;

const { locale, number } = Astro.props;
const t = getTranslations(locale);
const links = [
  { method: ContactMethod.Email, href: `mailto:${PROFILE.email}`, label: PROFILE.email },
  { method: ContactMethod.LinkedIn, href: PROFILE.linkedInUrl, label: t.linkedInLabel },
  { method: ContactMethod.GitHub, href: PROFILE.gitHubUrl, label: t.gitHubLabel },
];
const viewBox = `0 0 ${String(ICON_VIEWBOX_SIZE)} ${String(ICON_VIEWBOX_SIZE)}`;
---

<Section id={SectionId.Contact} number={number} title={t.sectionTitles[SectionId.Contact]}>
  <p class="contact__lead" data-reveal style={revealDelay(1)}>
    {t.contactLead}
  </p>
  <ul class="contact__links">
    {links.map((link, index) => (
      <li data-reveal style={revealDelay(index + 2)}>
        <a class="contact__link" href={link.href}>
          <svg
            class="contact__icon"
            viewBox={viewBox}
            fill="currentColor"
            aria-hidden="true"
            focusable="false"
          >
            <path d={CONTACT_ICON_PATHS[link.method]} />
          </svg>
          <span>{link.label}</span>
        </a>
      </li>
    ))}
  </ul>
</Section>

<style>
  .contact__lead {
    font-family: var(--font-family-serif);
    font-size: var(--type-lede-size);
    line-height: var(--type-lede-leading);
    margin-block-end: var(--space-5);
  }

  .contact__links {
    display: grid;
    gap: var(--space-3);
  }

  .contact__link {
    align-items: center;
    display: inline-flex;
    font-size: var(--type-label-size);
    gap: var(--space-3);
    overflow-wrap: anywhere;
  }

  .contact__icon {
    block-size: var(--icon-size);
    color: var(--color-accent);
    flex: none;
    inline-size: var(--icon-size);
  }
</style>
