---
import type { Locale } from '@core/enums/locale.enum';
import { getTranslations } from '@i18n/i18n';

interface Props {
  readonly locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<!-- Persisted across the language switch, so the scene keeps running instead of restarting. -->
<canvas
  class="background-3d"
  aria-hidden="true"
  data-background-3d
  transition:persist="background-3d"
></canvas>

<!--
  Running totals of the proximity queries. Empty and invisible until the first
  click on empty space; decorative, so hidden from assistive technology.
-->
<p
  class="query-readout"
  aria-hidden="true"
  data-query-readout
  data-label-query={t.queryLabel}
  data-label-queries={t.queriesLabel}
  data-label-edges={t.edgesLabel}
  data-label-reconstructed={t.reconstructedLabel}
></p>

<script>
  import { initBackground3d } from './background-3d.client';

  initBackground3d(document);
</script>

<style>
  .background-3d {
    block-size: 100vh;
    inline-size: 100vw;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    position: fixed;
    transition: opacity var(--motion-background-fade) var(--motion-ease-out);
    z-index: -1;
  }

  /* Set by the scene once its first frame is drawn, so the shape fades in instead of popping. */
  .background-3d[data-background-ready] {
    opacity: 1;
  }

  /* Tucked under the section marker, in the same corner and the same voice. */
  .query-readout {
    background: var(--color-paper);
    color: var(--color-muted);
    font-size: var(--type-small-size);
    inset-block-start: var(--layout-marker-clearance);
    inset-inline-end: var(--space-5);
    opacity: 0;
    padding: var(--space-1) var(--space-2);
    pointer-events: none;
    position: fixed;
    transition: opacity var(--motion-reveal) var(--motion-ease-out);
    white-space: nowrap;
    z-index: var(--layer-marker);
  }

  .query-readout[data-visible] {
    opacity: 1;
  }

  /* Narrow screens: the title sits right under the marker, so use the marker's row instead. */
  @media (width < 700px) {
    .query-readout {
      inset-block-start: var(--space-5);
      inset-inline: var(--space-gutter) auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .background-3d,
    .query-readout {
      transition: none;
    }
  }
</style>
