---
interface Props {
  readonly lead: string;
  readonly email: string;
  readonly linkedInLabel: string;
  readonly linkedInUrl: string;
  readonly gitHubLabel: string;
  readonly gitHubUrl: string;
}

const { lead, email, linkedInLabel, linkedInUrl, gitHubLabel, gitHubUrl } = Astro.props;
---

<div class="contact-block">
  <p class="contact-block__lead">{lead}</p>
  <p class="contact-block__email"><a href={`mailto:${email}`}>{email}</a></p>
  <p class="contact-block__links">
    <a href={linkedInUrl}>{linkedInLabel}</a>
    <span aria-hidden="true"> · </span>
    <a href={gitHubUrl}>{gitHubLabel}</a>
  </p>
</div>

<style>
  .contact-block__lead {
    font-family: var(--font-serif);
    font-size: var(--type-lede-size);
    line-height: var(--type-lede-leading);
    margin: 0 0 var(--space-4);
  }

  .contact-block__email {
    font-size: 1rem;
    margin: 0 0 var(--space-3);
    overflow-wrap: anywhere;
  }

  .contact-block__links {
    font-size: var(--type-mono-label-size);
    margin: 0;
  }
</style>
