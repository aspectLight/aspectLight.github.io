---
import type { SectionId } from '@core/enums/section-id.enum';

interface Props {
  readonly id: SectionId;
  readonly number: number;
  readonly title: string;
}

const { id, number, title } = Astro.props;
const headingId = `${id}-heading`;
const marker = `§ ${String(number)}`;
---

<section class="section" id={id} aria-labelledby={headingId} data-marker={marker}>
  <header class="section__header" data-reveal>
    <h2 class="section__heading" id={headingId}>
      {marker} — {title}
    </h2>
    <hr class="section__rule" />
  </header>
  <slot />
</section>

<style>
  .section {
    position: relative;
    padding-block: var(--space-section);
    padding-inline: var(--layout-offset) var(--space-gutter);
  }

  .section__header {
    margin-block-end: var(--space-6);
  }

  .section__heading {
    color: var(--color-accent);
    font-size: var(--type-label-size);
    font-weight: 400;
    letter-spacing: var(--type-label-tracking);
    line-height: var(--type-label-leading);
    margin-block-end: var(--space-2);
  }

  .section__rule {
    block-size: var(--line-width);
    background: var(--color-rule);
    border: 0;
    margin: 0;
  }
</style>
