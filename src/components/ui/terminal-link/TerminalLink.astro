---
interface Props {
  readonly href: string;
  readonly label: string;
}

const { href, label } = Astro.props;
---

<a class="terminal-link" href={href}>
  {label}
</a>

<style>
  .terminal-link {
    font-size: var(--type-label-size);
    overflow-wrap: anywhere;
  }

  .terminal-link::before {
    color: var(--color-accent);
    content: '> ';
  }
</style>
