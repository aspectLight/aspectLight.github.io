---
import type { Locale } from '@i18n/locales';

interface Props {
  readonly locale: Locale;
  readonly name: string;
  readonly homeHref: string;
  readonly sectionLabel: string;
  readonly languageNavLabel: string;
  readonly currentLocaleLabel: string;
  readonly otherLocale: Locale;
  readonly otherLocaleLabel: string;
  readonly otherHref: string;
}

const {
  locale,
  name,
  homeHref,
  sectionLabel,
  languageNavLabel,
  currentLocaleLabel,
  otherLocale,
  otherLocaleLabel,
  otherHref,
} = Astro.props;
---

<header class="running-head">
  <a class="running-head__name" href={homeHref}>{name}</a>
  <p class="running-head__section">{sectionLabel}</p>
  <nav class="running-head__languages" aria-label={languageNavLabel}>
    <span aria-current="true" lang={locale}>{currentLocaleLabel}</span>
    <span aria-hidden="true"> · </span>
    <a href={otherHref} hreflang={otherLocale} lang={otherLocale}>{otherLocaleLabel}</a>
  </nav>
</header>

<style>
  .running-head {
    align-items: center;
    background: var(--color-paper);
    border-block-end: 0.0625rem solid var(--color-rule);
    color: var(--color-muted);
    display: grid;
    font-size: var(--type-mono-small-size);
    gap: var(--space-3);
    grid-template-columns: 1fr auto;
    line-height: var(--type-mono-small-leading);
    min-block-size: var(--size-running-head);
    padding-block: var(--space-2);
    padding-inline: var(--space-gutter);
  }

  .running-head__section {
    display: none;
    margin: 0;
  }

  .running-head__languages {
    display: flex;
    gap: var(--space-1);
  }

  .running-head__languages [aria-current='true'] {
    color: var(--color-ink);
  }

  @media (min-width: 700px) {
    .running-head {
      grid-template-columns: 1fr auto 1fr;
      inset-block-start: 0;
      padding-inline: var(--space-offset);
      position: sticky;
      z-index: 1;
    }

    .running-head__section {
      display: block;
    }

    .running-head__languages {
      justify-self: end;
    }
  }
</style>
